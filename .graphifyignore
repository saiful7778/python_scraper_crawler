node_modules/
vendor/
bower_components/
jspm_packages/
.pnpm-store/
.yarn/
package-lock.json
yarn.lock
pnpm-lock.yaml
composer.lock
Gemfile.lock
poetry.lock
Pipfile.lock

# --- 2. Build Outputs & Compilation ---
dist/
build/
out/
target/
bin/
obj/
*.exe
*.dll
*.so
*.dylib
*.class
*.pyc
*.pyo
*.o
*.a
*.lib

