{
  "resources/**/*.{ts,tsx}": [
    "eslint --max-warnings 0 --config ./eslint.config.js"
  ],
  "resources/**/*": ["prettier --write"],
  "{app,bootstrap,cli,commands,config,providers,routes,tasks,tests}/**/*.py": [
    "uv run ruff check --force-exclude --fix",
    "uv run ruff format --force-exclude"
  ],
  "*.md": ["prettier --write"]
}
